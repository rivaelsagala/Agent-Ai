# OpenRouter (OpenAI-compatible) credentials
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TEMPERATURE=0.0
HTTP_TIMEOUT=30

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/market_news
DATABASE_SCHEMA=market_news
AUTO_MIGRATE=true

# Protect manual/admin endpoints; send this value in X-Admin-Key
ADMIN_API_KEY=replace-with-a-long-random-value

# Market-news worker
NEWS_USER_AGENT=ZimboMarketNewsBot/1.0 (+contact: admin@example.com)
NEWS_FETCH_TIMEOUT=30
MONITOR_TICK_SECONDS=60
DISPATCH_INTERVAL_SECONDS=30
MAX_DELIVERY_ATTEMPTS=3
DIGEST_LOOKBACK_HOURS=24
RUN_ON_STARTUP=true

# Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Email credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
EMAIL_NETWORK_TIMEOUT=30

# User identity used in email drafts
USER_NAME=
USER_EMAIL=rivaelsagala12345@gmail.com

# Channel Recipients
NOTIFICATION_EMAIL_TO=rivaelsagala12345@gmail.com
NOTIFICATION_WA_TO=082211739374
NOTIFICATION_TELEGRAM_TO=082211739374

# FastAPI / Uvicorn server configuration
HOST=127.0.0.1
PORT=5000

